{
  "headers": [
    {
      "source": "/GymLedger.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"GymLedger.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/GymLedger.apk",
      "dest": "/GymLedger.apk"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
