# Listening port for Express API server
PORT=5000

# MongoDB connection string (local or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/gym-management-saas

# JSON Web Token Secret key for auth signature
JWT_SECRET=super-secret-key-for-india-gym-saas-2026

# Google OAuth Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
