# Base URL for the Express API Backend.
# In development, leave blank to use the Vite proxy configuration (targeting http://localhost:5000).
# In production (e.g., on Vercel), set this to your deployed Render/Railway API URL (e.g., https://gym-saas-backend.onrender.com).
# Note: Do not append a trailing slash.
VITE_API_BASE_URL=
